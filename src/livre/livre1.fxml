<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<AnchorPane prefHeight="700.0" prefWidth="1000.0"
            styleClass="management-root"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="livre.LivreController">
    <stylesheets>
        <URL value="@style.css"/>
        <URL value="@styleLivre.css"/>
    </stylesheets>
    <children>
        <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <top>
                <HBox alignment="CENTER_LEFT" spacing="14" styleClass="management-header">
                    <Label text="📚" styleClass="action-icon"/>
                    <VBox spacing="3">
                        <Label text="Gestion des livres" styleClass="management-title"/>
                        <Label text="Ajoutez, modifiez et retrouvez facilement les ouvrages du catalogue." styleClass="management-subtitle"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button mnemonicParsing="false" onAction="#retourAuTableauDeBord" styleClass="back-button" text="← Tableau de bord"/>
                </HBox>
            </top>
            <center>
                <VBox spacing="16" styleClass="management-content">
                    <VBox spacing="13" styleClass="form-card">
                        <VBox spacing="3">
                            <Label text="Informations du livre" styleClass="card-title"/>
                            <Label text="Remplissez les informations puis choisissez une action." styleClass="card-hint"/>
                        </VBox>
                        <HBox spacing="10">
                            <TextField fx:id="txtTitre" maxWidth="1.7976931348623157E308" promptText="Titre" styleClass="form-field" HBox.hgrow="ALWAYS"/>
                            <TextField fx:id="txtAuteur" maxWidth="1.7976931348623157E308" promptText="Auteur" styleClass="form-field" HBox.hgrow="ALWAYS"/>
                            <TextField fx:id="txtCategorie" maxWidth="1.7976931348623157E308" promptText="Catégorie" styleClass="form-field" HBox.hgrow="ALWAYS"/>
                        </HBox>
                        <HBox spacing="10">
                            <TextField fx:id="txtISBN" maxWidth="1.7976931348623157E308" promptText="ISBN" styleClass="form-field" HBox.hgrow="ALWAYS"/>
                            <TextField fx:id="txtEditeur" maxWidth="1.7976931348623157E308" promptText="Éditeur" styleClass="form-field" HBox.hgrow="ALWAYS"/>
                            <TextField fx:id="txtDatePublication" maxWidth="1.7976931348623157E308" promptText="Date de publication (AAAA-MM-JJ)" styleClass="form-field" HBox.hgrow="ALWAYS"/>
                            <TextField fx:id="txtNombreExemplaires" maxWidth="1.7976931348623157E308" promptText="Nombre d'exemplaires" styleClass="form-field" HBox.hgrow="ALWAYS"/>
                        </HBox>
                        <HBox spacing="9">
                            <Button fx:id="btnAjouter" mnemonicParsing="false" onAction="#ajouterLivre" styleClass="primary-button" text="Ajouter le livre"/>
                            <Button fx:id="btnModifier" mnemonicParsing="false" onAction="#modifierLivre" styleClass="secondary-button" text="Modifier le livre"/>
                            <Button fx:id="btnSupprimer" mnemonicParsing="false" onAction="#supprimerLivre" styleClass="danger-button" text="Supprimer le livre"/>
                        </HBox>
                    </VBox>
                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="search-card">
                        <VBox spacing="2">
                            <Label text="Recherche" styleClass="card-title"/>
                            <Label text="Filtrez le catalogue." styleClass="card-hint"/>
                        </VBox>
                        <Region minWidth="6.0"/>
                        <TextField fx:id="txtRecherche" maxWidth="1.7976931348623157E308" promptText="Titre, auteur ou catégorie..." styleClass="search-field" HBox.hgrow="ALWAYS"/>
                        <Button mnemonicParsing="false" onAction="#rechercherLivre" styleClass="search-button" text="Rechercher"/>
                        <Button mnemonicParsing="false" onAction="#afficherTousLesLivres" styleClass="clear-button" text="Afficher tous"/>
                    </HBox>
                    <VBox spacing="8" VBox.vgrow="ALWAYS">
                        <Label text="Catalogue" styleClass="card-title"/>
                        <TableView fx:id="tableLivres" styleClass="library-table" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colId" prefWidth="60.0" text="ID"/>
                                <TableColumn fx:id="colTitre" prefWidth="235.0" text="Titre"/>
                                <TableColumn fx:id="colAuteur" prefWidth="190.0" text="Auteur"/>
                                <TableColumn fx:id="colCategorie" prefWidth="170.0" text="Catégorie"/>
                                <TableColumn fx:id="colExemplaires" prefWidth="130.0" text="Exemplaires"/>
                                <TableColumn fx:id="colDisponibles" prefWidth="130.0" text="Disponibles"/>
                            </columns>
                        </TableView>
                        <Label fx:id="lblMessage" maxWidth="1.7976931348623157E308" styleClass="status-message"/>
                    </VBox>
                </VBox>
            </center>
        </BorderPane>
    </children>
</AnchorPane>
