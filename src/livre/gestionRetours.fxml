<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="livre.GestionRetoursController"
      prefWidth="1000.0"
      prefHeight="680.0"
      styleClass="management-root">

    <stylesheets>
        <URL value="@style.css"/>
        <URL value="@styleSuivi.css"/>
    </stylesheets>

    <!-- ================= EN-TÊTE ================= -->
    <HBox alignment="CENTER_LEFT"
          spacing="14"
          styleClass="management-header">

        <Label text="📥" styleClass="suivi-header-icon"/>

        <VBox spacing="3">
            <Label text="Gestion des retours" styleClass="management-title"/>
            <Label text="Enregistrez les livres rendus et consultez l'historique."
                   styleClass="management-subtitle"/>
        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="← Tableau de bord"
                onAction="#retourAuTableauDeBord"
                styleClass="back-button"/>
    </HBox>

    <!-- ================= CONTENU ================= -->
    <VBox spacing="18"
          styleClass="management-content"
          VBox.vgrow="ALWAYS">

        <!-- Enregistrer un retour -->
        <VBox spacing="12" styleClass="form-card">

            <VBox spacing="2">
                <Label text="Enregistrer un retour" styleClass="card-title"/>
                <Label fx:id="lblARendre"
                       text="Chargement..."
                       styleClass="card-hint"/>
            </VBox>

            <GridPane hgap="16" vgap="6">

                <columnConstraints>
                    <ColumnConstraints percentWidth="65.0" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="35.0" hgrow="ALWAYS"/>
                </columnConstraints>

                <VBox spacing="5" GridPane.columnIndex="0">
                    <Label text="Emprunt concerné" styleClass="field-label"/>
                    <ComboBox fx:id="cmbEmpruntRetour"
                              promptText="Choisir un emprunt"
                              maxWidth="Infinity"
                              styleClass="form-field"/>
                </VBox>

                <VBox spacing="5" GridPane.columnIndex="1">
                    <Label text="Date du retour" styleClass="field-label"/>
                    <DatePicker fx:id="dateRetourReelle"
                                promptText="Choisir une date"
                                maxWidth="Infinity"
                                styleClass="form-field"/>
                </VBox>

            </GridPane>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Button text="Enregistrer le retour"
                        onAction="#enregistrerRetour"
                        styleClass="primary-button"/>

                <Button text="Modifier le retour"
                        onAction="#modifierRetour"
                        styleClass="secondary-button"/>

                <Label fx:id="lblMessage"
                       styleClass="status-message"
                       wrapText="true"
                       HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>

        <!-- Historique des retours -->
        <VBox spacing="12"
              styleClass="form-card"
              VBox.vgrow="ALWAYS">

            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="2">
                    <Label text="Retours enregistrés" styleClass="card-title"/>
                    <Label text="Cliquez sur une ligne pour corriger sa date de retour."
                           styleClass="card-hint"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <TextField fx:id="txtRecherche"
                           promptText="Rechercher un livre ou un adhérent"
                           prefWidth="300.0"
                           styleClass="search-field"/>
            </HBox>

            <TableView fx:id="tableRetours"
                       styleClass="library-table"
                       VBox.vgrow="ALWAYS">

                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>

                <placeholder>
                    <Label text="Aucun retour enregistré." styleClass="card-hint"/>
                </placeholder>

                <columns>
                    <TableColumn fx:id="colId" text="N°" prefWidth="50"/>
                    <TableColumn fx:id="colLivre" text="Livre" prefWidth="230"/>
                    <TableColumn fx:id="colNom" text="Nom" prefWidth="110"/>
                    <TableColumn fx:id="colPrenom" text="Prénom" prefWidth="110"/>
                    <TableColumn fx:id="colRetourPrevu" text="Retour prévu" prefWidth="105"/>
                    <TableColumn fx:id="colRetourReel" text="Rendu le" prefWidth="105"/>
                    <TableColumn fx:id="colEcart" text="Délai" prefWidth="110"/>
                </columns>
            </TableView>
        </VBox>

    </VBox>

</VBox>
