<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="livre.MonProfilController"
      spacing="20"
      alignment="CENTER"
      stylesheets="@profil.css">

    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <Label text="MON PROFIL"
           styleClass="titre"/>

    <GridPane hgap="25"
              vgap="15"
              styleClass="profil-box">

        <Label text="Nom :"
               styleClass="label-champ"
               GridPane.rowIndex="0"
               GridPane.columnIndex="0"/>

        <Label fx:id="lblNom"
               styleClass="label-valeur"
               GridPane.rowIndex="0"
               GridPane.columnIndex="1"/>


        <Label text="Prénom :"
               styleClass="label-champ"
               GridPane.rowIndex="1"
               GridPane.columnIndex="0"/>

        <Label fx:id="lblPrenom"
               styleClass="label-valeur"
               GridPane.rowIndex="1"
               GridPane.columnIndex="1"/>


        <Label text="Login :"
               styleClass="label-champ"
               GridPane.rowIndex="2"
               GridPane.columnIndex="0"/>

        <Label fx:id="lblLogin"
               styleClass="label-valeur"
               GridPane.rowIndex="2"
               GridPane.columnIndex="1"/>


        <Label text="Adresse :"
               styleClass="label-champ"
               GridPane.rowIndex="3"
               GridPane.columnIndex="0"/>

        <Label fx:id="lblAdresse"
               styleClass="label-valeur"
               GridPane.rowIndex="3"
               GridPane.columnIndex="1"/>


        <Label text="Téléphone :"
               styleClass="label-champ"
               GridPane.rowIndex="4"
               GridPane.columnIndex="0"/>

        <Label fx:id="lblTelephone"
               styleClass="label-valeur"
               GridPane.rowIndex="4"
               GridPane.columnIndex="1"/>


        <Label text="Email :"
               styleClass="label-champ"
               GridPane.rowIndex="5"
               GridPane.columnIndex="0"/>

        <Label fx:id="lblEmail"
               styleClass="label-valeur"
               GridPane.rowIndex="5"
               GridPane.columnIndex="1"/>


        <Label text="Date d'inscription :"
               styleClass="label-champ"
               GridPane.rowIndex="6"
               GridPane.columnIndex="0"/>

        <Label fx:id="lblDateInscription"
               styleClass="label-valeur"
               GridPane.rowIndex="6"
               GridPane.columnIndex="1"/>

    </GridPane>

    <HBox alignment="CENTER">

        <Button text="Retour"
                styleClass="bouton-retour"
                onAction="#retour"/>

    </HBox>

</VBox>