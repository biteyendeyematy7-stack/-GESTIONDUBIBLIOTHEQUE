<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="720.0"
            prefWidth="1080.0"
            styleClass="management-root"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="livre.MesEmpruntsController">

    <stylesheets>
        <URL value="@style.css"/>
        <URL value="@styleAdherent.css"/>
        <URL value="@styleCartes.css"/>
    </stylesheets>

    <children>
        <BorderPane AnchorPane.topAnchor="0.0"
                    AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0">

            <top>
                <HBox alignment="CENTER_LEFT"
                      spacing="14"
                      styleClass="management-header">
                    <Label text="📖" styleClass="action-icon"/>
                    <VBox spacing="3">
                        <Label text="MES EMPRUNTS" styleClass="management-title"/>
                        <Label text="Consultez l'historique de vos emprunts."
                               styleClass="management-subtitle"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="← Tableau de bord"
                            onAction="#retourAuTableauDeBord"
                            styleClass="back-button"/>
                </HBox>
            </top>

            <center>
                <VBox spacing="14" styleClass="loan-content">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <VBox spacing="4">
                            <Label text="Votre historique" styleClass="loan-page-title"/>
                            <Label fx:id="lblMessage"
                                   text="Chargement de vos emprunts..."
                                   styleClass="loan-summary"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                    </HBox>

                    <HBox spacing="10" styleClass="loan-filters">
                        <Button fx:id="btnTous"
                                text="Tous (0)"
                                onAction="#filtrerTous"
                                styleClass="loan-filter,loan-filter-active"/>
                        <Button fx:id="btnEnCours"
                                text="En cours (0)"
                                onAction="#filtrerEnCours"
                                styleClass="loan-filter"/>
                        <Button fx:id="btnEnRetard"
                                text="En retard (0)"
                                onAction="#filtrerEnRetard"
                                styleClass="loan-filter"/>
                        <Button fx:id="btnRetournes"
                                text="Retournés (0)"
                                onAction="#filtrerRetournes"
                                styleClass="loan-filter"/>
                    </HBox>

                    <ScrollPane fitToWidth="true"
                                hbarPolicy="NEVER"
                                styleClass="page-scroll,loan-scroll"
                                VBox.vgrow="ALWAYS">
                        <content>
                            <VBox fx:id="conteneurEmprunts"
                                  spacing="14"
                                  fillWidth="true"/>
                        </content>
                    </ScrollPane>

                    <VBox spacing="6" styleClass="loan-info">
                        <Label text="Comment lire votre historique ?"
                               styleClass="loan-info-title"/>
                        <Label text="Les emprunts en cours affichent leur date de retour prévue. Après le retour, la date effective et le statut sont indiqués."
                               wrapText="true"
                               styleClass="loan-info-text"/>
                    </VBox>
                </VBox>
            </center>
        </BorderPane>
    </children>
</AnchorPane>
