<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="livre.MonProfilController"
      prefWidth="780.0"
      prefHeight="600.0"
      styleClass="profil-root"
      stylesheets="@profil.css">

    <!-- ================= EN-TÊTE ================= -->
    <HBox alignment="CENTER_LEFT"
          spacing="14"
          styleClass="profil-header">

        <Label text="👤" styleClass="header-icon"/>

        <VBox spacing="3">
            <Label text="Mon profil" styleClass="titre"/>
            <Label text="Vos informations personnelles à la bibliothèque."
                   styleClass="sous-titre"/>
        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="Retour"
                onAction="#retour"
                styleClass="bouton-retour"/>
    </HBox>

    <!-- ================= CONTENU ================= -->
    <VBox spacing="22"
          styleClass="profil-content"
          VBox.vgrow="ALWAYS">

        <!-- Carte d'identité -->
        <HBox alignment="CENTER_LEFT"
              spacing="24"
              styleClass="identity-card">

            <Label fx:id="lblInitiales"
                   text="?"
                   styleClass="avatar"/>

            <VBox spacing="8">

                <Label fx:id="lblNomComplet"
                       text="Chargement..."
                       styleClass="nom-complet"/>

                <HBox>
                    <Label fx:id="lblLogin"
                           styleClass="login-chip"/>
                </HBox>

                <Label text="Adhérent de la bibliothèque"
                       styleClass="role-text"/>
            </VBox>
        </HBox>

        <Label text="Mes coordonnées" styleClass="section-title"/>

        <!-- Coordonnées -->
        <GridPane hgap="16" vgap="16">

            <columnConstraints>
                <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS"/>
                <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS"/>
            </columnConstraints>

            <!-- Adresse -->
            <HBox alignment="CENTER_LEFT" spacing="14"
                  styleClass="info-card"
                  GridPane.rowIndex="0" GridPane.columnIndex="0">
                <Label text="📍" styleClass="info-icon,badge-brown"/>
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label text="Adresse" styleClass="info-caption"/>
                    <Label fx:id="lblAdresse"
                           wrapText="true"
                           styleClass="info-value"/>
                </VBox>
            </HBox>

            <!-- Téléphone -->
            <HBox alignment="CENTER_LEFT" spacing="14"
                  styleClass="info-card"
                  GridPane.rowIndex="0" GridPane.columnIndex="1">
                <Label text="📞" styleClass="info-icon,badge-green"/>
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label text="Téléphone" styleClass="info-caption"/>
                    <Label fx:id="lblTelephone"
                           wrapText="true"
                           styleClass="info-value"/>
                </VBox>
            </HBox>

            <!-- E-mail -->
            <HBox alignment="CENTER_LEFT" spacing="14"
                  styleClass="info-card"
                  GridPane.rowIndex="1" GridPane.columnIndex="0">
                <Label text="✉" styleClass="info-icon,badge-orange"/>
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label text="Adresse e-mail" styleClass="info-caption"/>
                    <Label fx:id="lblEmail"
                           wrapText="true"
                           styleClass="info-value"/>
                </VBox>
            </HBox>

            <!-- Date d'inscription -->
            <HBox alignment="CENTER_LEFT" spacing="14"
                  styleClass="info-card"
                  GridPane.rowIndex="1" GridPane.columnIndex="1">
                <Label text="📅" styleClass="info-icon,badge-brass"/>
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label text="Inscrit depuis le" styleClass="info-caption"/>
                    <Label fx:id="lblDateInscription"
                           wrapText="true"
                           styleClass="info-value"/>
                </VBox>
            </HBox>

        </GridPane>

    </VBox>

</VBox>
