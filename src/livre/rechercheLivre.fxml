<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="650.0" prefWidth="1000.0"
            styleClass="management-root"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="livre.RechercheLivreController">

    <stylesheets>
        <URL value="@style.css"/>
        <URL value="@styleAdherent.css"/>
        <URL value="@styleCartes.css"/>
    </stylesheets>

    <children>

        <BorderPane AnchorPane.topAnchor="0.0"
                    AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0">

            <top>
                <HBox alignment="CENTER_LEFT"
                      spacing="14"
                      styleClass="management-header">

                    <Label text="⌕" styleClass="action-icon"/>

                    <VBox spacing="3">
                        <Label text="RECHERCHE DE LIVRES"
                               styleClass="management-title"/>
                        <Label text="Recherchez un livre par son titre, un auteur ou sa catégorie."
                               styleClass="management-subtitle"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button text="← Tableau de bord"
                            onAction="#retourAuTableauDeBord"
                            styleClass="back-button"/>
                </HBox>
            </top>

            <center>
                <VBox spacing="16" styleClass="management-content">

                    <VBox spacing="12" styleClass="search-card">
                        <Label text="Rechercher un livre" styleClass="card-title"/>

                        <HBox spacing="10">
                            <TextField fx:id="txtRecherche"
                                       promptText="Titre, auteur ou catégorie..."
                                       styleClass="search-field"
                                       maxWidth="1.7976931348623157E308"
                                       HBox.hgrow="ALWAYS"/>

                            <Button text="Rechercher"
                                    onAction="#rechercher"
                                    styleClass="search-button"/>

                            <Button text="Afficher tous les livres"
                                    onAction="#afficherTousLesLivres"
                                    styleClass="search-button"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="8" VBox.vgrow="ALWAYS">
                        <Label text="Résultats de la recherche" styleClass="card-title"/>

                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll" VBox.vgrow="ALWAYS">
                            <content>
                                <FlowPane fx:id="grilleLivres"
                                          hgap="22"
                                          vgap="26"
                                          styleClass="grille-livres"/>
                            </content>
                        </ScrollPane>

                        <Label fx:id="lblMessage" styleClass="status-message"/>
                    </VBox>

                </VBox>
            </center>

        </BorderPane>

    </children>

</AnchorPane>