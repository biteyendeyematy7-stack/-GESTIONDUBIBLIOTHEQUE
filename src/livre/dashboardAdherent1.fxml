<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<AnchorPane prefHeight="620.0" prefWidth="620.0"
            styleClass="dashboard-root"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="livre.DashboardAdherentController">
    <stylesheets>
        <URL value="@style.css"/>
        <URL value="@styleAdherent.css"/>
    </stylesheets>
    <children>
        <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <top>
                <HBox alignment="CENTER_LEFT" spacing="16" styleClass="app-header">
                    <VBox spacing="4">
                        <Label text="GESTION DE BIBLIOTHÈQUE" styleClass="app-kicker"/>
                        <Label text="Mon espace lecteur" styleClass="app-title"/>
                        <Label text="Retrouvez vos livres et vos emprunts facilement." styleClass="app-subtitle"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="ADHÉRENT" styleClass="role-badge"/>
                </HBox>
            </top>
            <center>
                <VBox spacing="22" styleClass="content-area">
                    <VBox spacing="4" styleClass="welcome-card">
                        <Label text="BONNE LECTURE" styleClass="welcome-caption"/>
                        <Label fx:id="lblBienvenue" text="Bienvenue" styleClass="welcome-name"/>
                    </VBox>
                    <VBox spacing="5">
                        <Label text="Que souhaitez-vous faire ?" styleClass="section-title"/>
                        <Label text="Accédez à votre bibliothèque en quelques clics." styleClass="section-hint"/>
                    </VBox>
                    <VBox spacing="12">
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#consulterLivres" styleClass="action-card" text="Consulter les livres">
                            <graphic><Label text="📚" styleClass="action-icon"/></graphic>
                        </Button>
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#rechercherLivre" styleClass="action-card" text="Rechercher un livre">
                            <graphic><Label text="⌕" styleClass="action-icon"/></graphic>
                        </Button>
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#mesEmprunts" styleClass="action-card" text="Mes emprunts">
                            <graphic><Label text="↔" styleClass="action-icon"/></graphic>
                        </Button>
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#monProfil" styleClass="action-card" text="Mon profil">
                            <graphic><Label text="●" styleClass="action-icon"/></graphic>
                        </Button>
                    </VBox>
                </VBox>
            </center>
            <bottom>
                <HBox alignment="CENTER" spacing="16" style="-fx-padding: 0 34 24 34;">
                    <Label text="Gestion de bibliothèque • Espace lecteur" styleClass="footer-text"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button mnemonicParsing="false" onAction="#deconnexion" styleClass="logout-button" text="Déconnexion"/>
                </HBox>
            </bottom>
        </BorderPane>
    </children>
</AnchorPane>
