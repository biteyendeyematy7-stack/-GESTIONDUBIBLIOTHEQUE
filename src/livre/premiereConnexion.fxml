<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="livre.PremiereConnexionController"
      alignment="CENTER"
      spacing="18"
      stylesheets="@style.css"
      styleClass="login-root">

    <padding>
        <Insets top="40"
                right="40"
                bottom="40"
                left="40"/>
    </padding>

    <VBox maxWidth="360"
          spacing="20"
          styleClass="login-panel">

        <!-- Titre -->
        <Label text="Première connexion"
               styleClass="login-title"/>

        <Label text="Choisissez votre mot de passe personnel."
               styleClass="login-subtitle"
               wrapText="true"/>

        <!-- Identifiant -->
        <VBox spacing="7">

            <Label text="Identifiant"
                   styleClass="field-label"/>

            <Label fx:id="lblLogin"
                   styleClass="login-subtitle"/>

        </VBox>

        <!-- Nouveau mot de passe -->
        <VBox spacing="7">

            <Label text="Nouveau mot de passe"
                   styleClass="field-label"/>

            <PasswordField fx:id="txtNouveauMotDePasse"
                           promptText="Choisissez votre mot de passe"
                           maxWidth="1.7976931348623157E308"
                           styleClass="login-field"/>

        </VBox>

        <!-- Confirmation -->
        <VBox spacing="7">

            <Label text="Confirmer le mot de passe"
                   styleClass="field-label"/>

            <PasswordField fx:id="txtConfirmation"
                           promptText="Confirmez votre mot de passe"
                           maxWidth="1.7976931348623157E308"
                           styleClass="login-field"/>

        </VBox>

        <!-- Bouton -->
        <Button text="Valider"
                maxWidth="1.7976931348623157E308"
                onAction="#valider"
                styleClass="login-button"/>

        <!-- Message -->
        <Label fx:id="lblMessage"
               maxWidth="1.7976931348623157E308"
               wrapText="true"
               styleClass="login-message"/>

    </VBox>

</VBox>