<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="livre.GestionEmpruntsController"
      prefWidth="1000.0"
      prefHeight="680.0"
      styleClass="management-root">

    <stylesheets>
        <URL value="@style.css"/>
        <URL value="@styleSuivi.css"/>
    </stylesheets>

    <fx:define>
        <ToggleGroup fx:id="groupeFiltre"/>
    </fx:define>

    <!-- ================= EN-TÊTE ================= -->
    <HBox alignment="CENTER_LEFT"
          spacing="14"
          styleClass="management-header">

        <Label text="📕" styleClass="suivi-header-icon"/>

        <VBox spacing="3">
            <Label text="Gestion des emprunts" styleClass="management-title"/>
            <Label text="Enregistrez les prêts et suivez leur statut."
                   styleClass="management-subtitle"/>
        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="← Tableau de bord"
                onAction="#retourAuTableauDeBord"
                styleClass="back-button"/>
    </HBox>

    <!-- ================= CONTENU ================= -->
    <VBox spacing="18"
          styleClass="management-content"
          VBox.vgrow="ALWAYS">

        <!-- Nouvel emprunt -->
        <VBox spacing="12" styleClass="form-card">

            <VBox spacing="2">
                <Label text="Nouvel emprunt" styleClass="card-title"/>
                <Label text="Choisissez un livre et un adhérent, puis indiquez les dates du prêt."
                       styleClass="card-hint"/>
            </VBox>

            <GridPane hgap="16" vgap="6">

                <columnConstraints>
                    <ColumnConstraints percentWidth="25.0" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="25.0" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="25.0" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="25.0" hgrow="ALWAYS"/>
                </columnConstraints>

                <VBox spacing="5" GridPane.columnIndex="0">
                    <Label text="Livre" styleClass="field-label"/>
                    <ComboBox fx:id="cmbLivre"
                              promptText="Choisir un livre"
                              maxWidth="Infinity"
                              styleClass="form-field"/>
                </VBox>

                <VBox spacing="5" GridPane.columnIndex="1">
                    <Label text="Adhérent" styleClass="field-label"/>
                    <ComboBox fx:id="cmbAdherent"
                              promptText="Choisir un adhérent"
                              maxWidth="Infinity"
                              styleClass="form-field"/>
                </VBox>

                <VBox spacing="5" GridPane.columnIndex="2">
                    <Label text="Date d'emprunt" styleClass="field-label"/>
                    <DatePicker fx:id="dateEmprunt"
                                promptText="Choisir une date"
                                maxWidth="Infinity"
                                styleClass="form-field"/>
                </VBox>

                <VBox spacing="5" GridPane.columnIndex="3">
                    <Label text="Retour prévu" styleClass="field-label"/>
                    <DatePicker fx:id="dateRetourPrevue"
                                promptText="Choisir une date"
                                maxWidth="Infinity"
                                styleClass="form-field"/>
                </VBox>

            </GridPane>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Button text="Enregistrer l'emprunt"
                        onAction="#ajouterEmprunt"
                        styleClass="primary-button"/>

                <Button text="Modifier l'emprunt"
                        onAction="#modifierEmprunt"
                        styleClass="secondary-button"/>

                <Label fx:id="lblMessage"
                       styleClass="status-message"
                       wrapText="true"
                       HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>

        <!-- Historique -->
        <VBox spacing="12"
              styleClass="form-card"
              VBox.vgrow="ALWAYS">

            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="2">
                    <Label text="Historique des emprunts" styleClass="card-title"/>
                    <Label text="Cliquez sur une ligne pour modifier ses dates."
                           styleClass="card-hint"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <TextField fx:id="txtRecherche"
                           promptText="Rechercher un livre ou un adhérent"
                           prefWidth="300.0"
                           styleClass="search-field"/>
            </HBox>

            <HBox spacing="8">
                <ToggleButton fx:id="btnTous" text="Tous"
                              toggleGroup="$groupeFiltre"
                              selected="true"
                              styleClass="filter-chip"/>
                <ToggleButton fx:id="btnEnCours" text="En cours"
                              toggleGroup="$groupeFiltre"
                              styleClass="filter-chip"/>
                <ToggleButton fx:id="btnRetard" text="En retard"
                              toggleGroup="$groupeFiltre"
                              styleClass="filter-chip"/>
                <ToggleButton fx:id="btnRetourne" text="Retournés"
                              toggleGroup="$groupeFiltre"
                              styleClass="filter-chip"/>
            </HBox>

            <TableView fx:id="tableEmprunts"
                       styleClass="library-table"
                       VBox.vgrow="ALWAYS">

                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>

                <placeholder>
                    <Label text="Aucun emprunt à afficher." styleClass="card-hint"/>
                </placeholder>

                <columns>
                    <TableColumn fx:id="colId" text="N°" prefWidth="50"/>
                    <TableColumn fx:id="colLivre" text="Livre" prefWidth="240"/>
                    <TableColumn fx:id="colNom" text="Nom" prefWidth="120"/>
                    <TableColumn fx:id="colPrenom" text="Prénom" prefWidth="120"/>
                    <TableColumn fx:id="colDateEmprunt" text="Emprunté le" prefWidth="110"/>
                    <TableColumn fx:id="colDateRetour" text="Retour prévu" prefWidth="110"/>
                    <TableColumn fx:id="colStatut" text="Statut" prefWidth="110"/>
                </columns>
            </TableView>
        </VBox>

    </VBox>

</VBox>
