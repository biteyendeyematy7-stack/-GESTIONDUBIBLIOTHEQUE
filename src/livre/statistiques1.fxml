<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="livre.StatistiquesController"
      alignment="CENTER"
      spacing="20"
      stylesheets="@statistiques.css">

    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <!-- Titre -->
    <Label text="TABLEAU DE BORD / STATISTIQUES"
           styleClass="titre-statistiques"/>

    <!-- Statistiques -->
    <GridPane hgap="20"
              vgap="20"
              alignment="CENTER"
              styleClass="stats-box">

        <!-- Livres -->
        <VBox alignment="CENTER"
              styleClass="carte-statistique"
              GridPane.rowIndex="0"
              GridPane.columnIndex="0">

            <Label text="📚"
                   styleClass="icone-statistique"/>

            <Label fx:id="lblLivres"
                   styleClass="statistique"/>
        </VBox>

        <!-- Disponibles -->
        <VBox alignment="CENTER"
              styleClass="carte-statistique"
              GridPane.rowIndex="0"
              GridPane.columnIndex="1">

            <Label text="📖"
                   styleClass="icone-statistique"/>

            <Label fx:id="lblDisponibles"
                   styleClass="statistique"/>
        </VBox>

        <!-- Adhérents -->
        <VBox alignment="CENTER"
              styleClass="carte-statistique"
              GridPane.rowIndex="1"
              GridPane.columnIndex="0">

            <Label text="👥"
                   styleClass="icone-statistique"/>

            <Label fx:id="lblAdherents"
                   styleClass="statistique"/>
        </VBox>

        <!-- Emprunts en cours -->
        <VBox alignment="CENTER"
              styleClass="carte-statistique"
              GridPane.rowIndex="1"
              GridPane.columnIndex="1">

            <Label text="📕"
                   styleClass="icone-statistique"/>

            <Label fx:id="lblEmprunts"
                   styleClass="statistique"/>
        </VBox>

        <!-- Retards -->
        <VBox alignment="CENTER"
              styleClass="carte-statistique"
              GridPane.rowIndex="2"
              GridPane.columnIndex="0">

            <Label text="🔴"
                   styleClass="icone-statistique"/>

            <Label fx:id="lblRetards"
                   styleClass="statistique"/>
        </VBox>

        <!-- Retours -->
        <VBox alignment="CENTER"
              styleClass="carte-statistique"
              GridPane.rowIndex="2"
              GridPane.columnIndex="1">

            <Label text="✅"
                   styleClass="icone-statistique"/>

            <Label fx:id="lblRetours"
                   styleClass="statistique"/>
        </VBox>

    </GridPane>

    <!-- Bouton -->
    <Button text="Fermer"
            styleClass="bouton-fermer"
            onAction="#fermer"/>

</VBox>